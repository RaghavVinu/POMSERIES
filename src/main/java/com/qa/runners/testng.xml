<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="All Test Suite" verbose="2" thread-count="1" parallel="tests">
    <listeners>
        <listener class-name="com.qa.listeners.ExtentReportListener"/>
        <listener class-name="com.qa.listeners.TestAllureListener"/>
    </listeners>
    <test name="Sanity tests1">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.qa.tests.LoginPageTests" />
        </classes>
    </test>

    <test name="Sanity tests2">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.qa.tests.AccountsPageTests" />
        </classes>
    </test>

    <test name="Sanity test3">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.qa.tests.RegisterTests" />
        </classes>
    </test>

</suite>